<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the pure C# Opponent core straight from Assets/ (one copy of the code). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>AdaptiveOpponent.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RepoRoot)Assets/Scripts/Core/**/*.cs" />
  </ItemGroup>
</Project>
